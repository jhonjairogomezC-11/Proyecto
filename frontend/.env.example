# =============================================================
# VoluntApp — Variables de entorno del frontend (Vite)
# Copia este archivo a frontend/.env y ajusta si es necesario.
# Las variables deben empezar con VITE_ para ser accesibles.
# =============================================================

# URL del backend (solo necesaria si cambias el proxy en vite.config.js)
# En desarrollo local no es necesario cambiar nada.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nombre de la aplicación (se muestra en el título)
VITE_APP_NAME=VoluntApp

# ── WebSocket / Laravel Reverb (opcional en desarrollo) ──────
# Sin estas variables la app funciona sin tiempo real.
# Copia los valores de REVERB_APP_* de tu .env del backend.
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http

# ── Proxy PHP (opcional, solo si corres varios artisan serve) ─
# VITE_PHP_SERVERS=http://127.0.0.1:8001,http://127.0.0.1:8002
