# =============================================================
# VoluntApp — Variables de entorno del frontend (Vite)
# Copia este archivo a frontend/.env y ajusta si es necesario.
# Las variables deben empezar con VITE_ para ser accesibles.
# =============================================================

# URL del backend (solo necesaria si cambias el proxy en vite.config.js)
# En desarrollo local no es necesario cambiar nada.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nombre de la aplicación (se muestra en el título)
VITE_APP_NAME=VoluntApp
