# =============================================================
# VoluntApp — Variables de entorno del backend
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=VoluntApp
APP_ENV=local                   # local | staging | production
APP_KEY=                        # Generado con: php artisan key:generate
APP_DEBUG=true                  # false en producción
APP_URL=http://localhost:8000   # URL base del backend

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 # debug | info | warning | error

# ── Base de datos (PostgreSQL) ────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voluntapp           # Nombre de tu base de datos
DB_USERNAME=postgres            # Usuario de PostgreSQL
DB_PASSWORD=                    # Contraseña de PostgreSQL

# ── Sesión ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache / Queue ────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Redis (opcional, solo si usas Redis en lugar de database) ─
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo ───────────────────────────────────────────────────
# En desarrollo usa 'log' para ver los emails en storage/logs
# En producción configura smtp con tus credenciales reales
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@voluntapp.co"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (para almacenamiento de archivos en producción) ────
# Dejar vacío en desarrollo local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Sanctum (CORS para el frontend) ──────────────────────────
# En producción agrega el dominio real del frontend
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
